":"photo","x":52.51820152085793,"y":64.09796976445988,"rot":2.3,"w":308,"img":"./uploads/866a1a39-accc-4c07-941b-a6d3a834beae.jpg","caption":"","color":"#c98a6b","z":107,"frame":"none","h":339},{"id":"photo-1785765990634","type":"photo","x":21.521054014684836,"y":37.52374217910304,"rot":-4.5,"w":361,"img":"./uploads/97bc082b-41ae-47e4-b754-0eb0f9e4d1aa.jpg","caption":"","color":"#9b7fa6","z":60,"frame":"none","h":323},{"id":"photo-1785766153336","type":"photo","x":4,"y":21.5419829352807,"rot":18,"w":190,"img":"./uploads/b8769989-d600-4bfd-b6f1-dfb53cc37052.jpg","caption":"","color":"#8c9b74","z":122},{"id":"note-1785768003016","type":"note","x":58.859052749390116,"y":27.72915438186501,"rot":0,"w":200,"text":"<span style=\"white-space: normal; color: rgb(24, 24, 24);\"><font style=\"font-size: 15px;\"><font style=\"\">“I’m a big believer in winging it. I’m a big believer that you’re never going to find perfect city travel experience or the perfect </font><font style=\"\">meal without a constant willingness to experience a bad one. Letting the happy accident happen is what a lot of vacation itineraries miss, I think, and I’m always trying to push people to allow those things to happen rather than stick to some rigid itinerary.”<br></font></font></span><div><span style=\"white-space: normal; color: rgb(24, 24, 24);\"><font style=\"font-size: 15px;\">- Anthony Bourdain</font></span></div>","color":"#c98a6b","z":128,"richText":true,"noteStyle":"sticky","font":"handwritten","noteColor":"#fff59d"},{"id":"photo-1785768128729","type":"photo","x":44.560984842831324,"y":24.24196355648556,"rot":-9,"w":190,"img":"./uploads/650b0f2b-60ed-4eba-bcb3-a295d0d91000.jpg","caption":" ","color":"#8c9b74","z":126},{"id":"photo-1785768142680","type":"photo","x":53.02216291762857,"y":108.07593288179027,"rot":-3.5,"w":190,"img":"./uploads/99dda193-3d41-40b9-aa32-1c7779b05d45.jpg","caption":" ","color":"#8c9b74","z":133},{"id":"photo-1785768161702","type":"photo","x":38.969463376174886,"y":95